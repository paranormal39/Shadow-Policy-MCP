# ─── Shadow Policy MCP — environment ───────────────────────────────────────
# Copy to .env and adjust. All values have safe testnet defaults; nothing here
# is required to run against the Mock facilitator.

# ── Network safety ──────────────────────────────────────────────────────────
# One of: testnet | devnet | mainnet.  Default: testnet.
XRPL_NETWORK=testnet
# Mainnet is refused unless this is exactly "true". Keeps real funds safe.
ALLOW_MAINNET=false

# ── Transport ───────────────────────────────────────────────────────────────
# stdio (desktop/CLI MCP clients) | http (remote/cloud agents). Default: stdio.
TRANSPORT=stdio
HTTP_PORT=8402
# Comma-separated bearer tokens accepted on the HTTP transport (optional).
HTTP_AUTH_TOKENS=

# ── x402 payment layer ──────────────────────────────────────────────────────
# mock  — deterministic, offline, no real XRP (default; used by tests/CI)
# t54   — real hosted T54 XRPL facilitator over HTTP
FACILITATOR=mock
# Override the facilitator base URL (defaults chosen per XRPL_NETWORK).
#   testnet default: https://xrpl-facilitator-testnet.t54.ai
#   mainnet default: https://xrpl-facilitator-mainnet.t54.ai
T54_FACILITATOR_URL=

# Where poll-creation (and other) payments are collected. MUST be set for the
# t54 facilitator; the mock facilitator accepts the placeholder.
MERCHANT_XRPL_ADDRESS=rMockMerchantAddressDoNotUseOnMainnet
# XRP or an issued-asset hex (e.g. RLUSD). Default XRP.
MERCHANT_ASSET=XRP

# ── Shadow Labz (votechain) backend ─────────────────────────────────────────
SHADOWLABZ_BASE_URL=http://localhost:3000
# Public host used to build shareable poll URLs (defaults to SHADOWLABZ_BASE_URL).
SHADOWLABZ_PUBLIC_URL=
# x-api-key for machine access (GAME_API_KEY or an sdk_ per-client key). Optional
# in dev when the votechain key gate has never been armed.
SHADOWLABZ_API_KEY=

# ── Receipts ────────────────────────────────────────────────────────────────
# HMAC secret used to sign payment/poll receipts. If unset an ephemeral secret
# is generated at boot (fine for dev; set a stable value in production).
RECEIPT_SIGNING_SECRET=

# ── Pricing (XRP, decimal) ──────────────────────────────────────────────────
PRICE_POLL_CREATE_XRP=1
PRICE_POLL_PREMIUM_XRP=2
PRICE_RESULTS_PURCHASE_XRP=0.5
PRICE_ANALYTICS_XRP=0.5

# ── Default spending policy per agent (XRP, decimal) ─────────────────────────
POLICY_PER_TX_LIMIT_XRP=5
POLICY_DAILY_LIMIT_XRP=25
POLICY_MONTHLY_LIMIT_XRP=100
# Payments at/above this value require human approval before authorization.
POLICY_HUMAN_APPROVAL_XRP=10

# ── Treasury policy (Phase 4) ────────────────────────────────────────────────
# Distinct approvals required before a treasury payment may execute.
TREASURY_APPROVALS_REQUIRED=2
# Require the spend to be linked to a finalized governance proposal (true/false).
TREASURY_REQUIRE_PROPOSAL=true
